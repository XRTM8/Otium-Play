name: Build & Release ZOET APK

on:
  workflow_dispatch:
    inputs:
      version:
        description: 'Release Version Tag (e.g. v1.0.0)'
        required: true
        default: 'v2.0.0'

permissions:
  contents: write

jobs:
  build-apk:
    name: Build & Publish APK
    runs-on: ubuntu-latest

    steps:
      - name: Checkout Source Code
        uses: actions/checkout@v4

      - name: Set up JDK 17
        uses: actions/setup-java@v4
        with:
          distribution: 'temurin'
          java-version: '17'

      - name: Setup Gradle 8.7
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.7'

      - name: Accept Android SDK Licenses
        run: |
          yes | $ANDROID_HOME/cmdline-tools/latest/bin/sdkmanager --licenses || true

      - name: Install Rust targets
        uses: dtolnay/rust-toolchain@stable
        with:
          targets: wasm32-unknown-unknown,aarch64-linux-android,armv7-linux-androideabi,i686-linux-android,x86_64-linux-android

      - name: Test Rust and build WebAssembly
        run: |
          cargo test --manifest-path rust/otium-core/Cargo.toml --locked
          cargo test --manifest-path rust/otium-ui/Cargo.toml --locked
          cargo install wasm-bindgen-cli --version 0.2.130 --locked
          cargo build --manifest-path rust/otium-ui/Cargo.toml --locked --target wasm32-unknown-unknown --release
          wasm-bindgen rust/otium-ui/target/wasm32-unknown-unknown/release/otium_ui.wasm --target web --no-typescript --out-dir public/wasm

      - name: Build Rust Android engine
        run: |
          "$ANDROID_HOME/cmdline-tools/latest/bin/sdkmanager" 'ndk;26.1.10909125' 'platforms;android-34' 'build-tools;34.0.0'
          ANDROID_NDK_HOME="$ANDROID_HOME/ndk/26.1.10909125" bash scripts/build-rust-android.sh

      - name: Synchronize Web Assets
        run: |
          mkdir -p android/app/src/main/assets/public
          cp -r public/* android/app/src/main/assets/public/

      - name: Restore stable signing key
        env:
          KEYSTORE_BASE64: ${{ secrets.KRMZI_KEYSTORE_BASE64 }}
        run: |
          test -n "$KEYSTORE_BASE64" || { echo "Missing stable signing key"; exit 1; }
          printf '%s' "$KEYSTORE_BASE64" | base64 --decode > "$RUNNER_TEMP/krmzi-release.keystore"
          chmod 600 "$RUNNER_TEMP/krmzi-release.keystore"

      - name: Build signed release
        env:
          KRMZI_KEYSTORE_PATH: ${{ runner.temp }}/krmzi-release.keystore
          KRMZI_STORE_PASSWORD: ${{ secrets.KRMZI_STORE_PASSWORD }}
          KRMZI_KEY_ALIAS: ${{ secrets.KRMZI_KEY_ALIAS }}
          KRMZI_KEY_PASSWORD: ${{ secrets.KRMZI_KEY_PASSWORD }}
        run: gradle -p android assembleRelease --no-daemon --stacktrace

      - name: Verify signature and stage exact release APK
        run: |
          set -euo pipefail
          EXPECTED_FINGERPRINT=$(tr -d '\r\n' < .github/signing-certificate.sha256)
          test -n "$EXPECTED_FINGERPRINT"
          APK_FILE=android/app/build/outputs/apk/release/app-release.apk
          APKSIGNER=$(find "$ANDROID_HOME/build-tools" -name apksigner | sort -V | tail -n 1)
          "$APKSIGNER" verify --print-certs "$APK_FILE" > "$RUNNER_TEMP/krmzi-cert.txt"
          ACTUAL=$(sed -n 's/^Signer #1 certificate SHA-256 digest: //p' "$RUNNER_TEMP/krmzi-cert.txt")
          test "$ACTUAL" = "$EXPECTED_FINGERPRINT" || { echo "Signing key mismatch"; exit 1; }
          mkdir -p release-output
          cp "$APK_FILE" release-output/otium-play.apk

      - name: Create GitHub Release & Upload APK
        uses: softprops/action-gh-release@v2
        with:
          tag_name: ${{ github.event.inputs.version || github.ref_name }}
          name: ZOET - ${{ github.event.inputs.version || github.ref_name }}
          body: |
            ZOET by Otium 2.0 — Rust/WebAssembly

            - قائمة مسلسلات وقائمة أفلام مستقلة بتصميم زجاج داكن.
            - تصفّح وبحث متعدد الصفحات ودمج قرمزي وسينمانا.
            - حفظ موضع المشاهدة وإعداداتها عند تبديل المصادر المباشرة.
            - محرك Rust مشترك وواجهة Rust/WebAssembly.

            توفّر سينمانا مرتبط باتصال المستخدم. سلاسة120FPS تحتاج جهازاً يدعمها وقياساً فعلياً.
          files: release-output/otium-play.apk
          draft: false
          prerelease: false
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
